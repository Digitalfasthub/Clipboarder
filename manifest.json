{
  "manifest_version": 3,
  "name": "Clipboarder",
  "version": "1.2.4",
  "description": "Collect multiple text selections into a list and paste them back one at a time, using two hotkeys you choose. Runs 100% locally.",
  "permissions": ["storage", "activeTab", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clipboarder",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "toggle-copy-mode": {
      "suggested_key": {
        "default": "Ctrl+Shift+C"
      },
      "description": "Turn copy-selection mode on/off"
    },
    "paste-next-item": {
      "suggested_key": {
        "default": "Ctrl+Shift+V"
      },
      "description": "Paste the next item from the collected list"
    }
  }
}
